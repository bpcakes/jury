#!/usr/bin/env bash
set -euo pipefail

# Consumer: J25 and the J26 Linux release gate.
# Feature gated: malformed public artifacts must not crash their owning parsers.
# Defect class: rejection-only or unbounded fuzz runs can look green without
# reaching valid parser paths. Remove this check only when these parser targets
# are removed or replaced by an equivalent bounded coverage-guided gate.

readonly toolchain="nightly-2026-08-25"
readonly manifest="fuzz/Cargo.toml"
readonly time_budget_seconds="10"
readonly rss_budget_mb="2048"
readonly sanitizer_options="${ASAN_OPTIONS:+${ASAN_OPTIONS}:}detect_leaks=0"

corpus_root="$(mktemp -d "${TMPDIR:-/tmp}/jury-j25-fuzz.XXXXXX")"
trap 'rm -rf -- "$corpus_root"' EXIT

cargo "+${toolchain}" test --manifest-path "$manifest" --locked
cargo "+${toolchain}" run --manifest-path "$manifest" --locked \
  --example seed_corpus -- "$corpus_root/corpus"

run_target() {
  local target="$1"
  local maximum_input_bytes="$2"
  local artifacts="$corpus_root/artifacts/$target/"
  mkdir -p "$artifacts"
  ASAN_OPTIONS="$sanitizer_options" \
    cargo "+${toolchain}" fuzz run "$target" "$corpus_root/corpus/$target" -- \
    "-max_total_time=${time_budget_seconds}" \
    "-max_len=${maximum_input_bytes}" \
    "-rss_limit_mb=${rss_budget_mb}" \
    "-artifact_prefix=${artifacts}" \
    -detect_leaks=0 \
    -verbosity=0 \
    -print_final_stats=1
}

# These are deterministic CI smoke budgets, not an exhaustive fuzzing claim.
# Large valid seeds are always executed even when mutation length is smaller.
# LeakSanitizer's ptrace-based process scan is disabled because common agent and
# CI runners prohibit it; AddressSanitizer remains active. J25's separate
# repository secret-leak scan is not implemented by this memory-leak setting.
run_target protocol 4194304
run_target witness 524288
run_target core_artifacts 2097152
run_target input_boundaries 524288
