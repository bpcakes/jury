    "description": "Prepare repository dependencies and local tooling.",
    "kind": "command",
    "name": "jig.bootstrap"
  },
  {
    "command": "api_clippy_command",
    "description": "Run Rust Clippy with repository policy.",
    "kind": "command",
    "name": "jig.clippy"
  },
  {
    "command": null,
    "description": "Validate the checked-in Jig repository contract.",
    "kind": "native",
    "name": "jig.contract_check"
  },
  {
    "command": "api_fmt_command",
    "description": "Check Rust formatting.",
    "kind": "command",
    "name": "jig.fmt_check"
  },
  {
    "command": "repo_rust_file_loc_command",
    "description": "Enforce the changed-file Rust source size policy.",
    "kind": "command",
    "name": "jig.rust_file_loc"
  },
  {
    "command": "api_test_command",
    "description": "Run Rust tests.",
    "kind": "command",
    "name": "jig.test"
  },
  {
    "command": "api_test_locked_command",
    "description": "Run Rust tests using the locked dependency graph.",
    "kind": "command",
    "name": "jig.test_locked"
  }
],
  "affected_ignore": [
  ".env",
  ".env.*",
  "**/.env",
  "**/.env.*",
  "README.md",
