{
  "contract_version": 6,
  "tool_namespace": "jig",

  "required_commands": [
  "api_clippy_command",
  "api_fmt_command",
  "api_test_command",
  "api_test_locked_command",
  "repo_bootstrap_command",
  "repo_rust_file_loc_command"
],
  "tools": [
  {
