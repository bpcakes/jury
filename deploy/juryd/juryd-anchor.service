[Unit]
Description=Jury pre-alpha external witness-anchor service (never use with real secrets)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=juryd-anchor
Group=juryd-anchor
UMask=0077
ExecStart=/usr/local/bin/juryd anchor serve --config /etc/juryd-anchor/anchor.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StateDirectory=juryd-anchor
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/juryd-anchor
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
